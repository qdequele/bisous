# meili-connect configuration. Copy to `.env`; blank values count as unset.

# --- Server ------------------------------------------------------------------

# Address the HTTP API listens on.
LISTEN_ADDR=0.0.0.0:8080

# --- State store -------------------------------------------------------------

# Postgres holding sync specs (sealed), checkpoints, dead letters, progress
# and the Lab usage outbox. Migrations run at startup.
# Unset: an IN-MEMORY store is used and NOTHING survives a restart (every
# sync snapshots again). Fine for a trial, never for production.
DATABASE_URL=postgres://connect:connect@localhost:5432/connect

# Base64 32-byte key sealing the specs at rest (ChaCha20-Poly1305).
# Required with DATABASE_URL. Generate: openssl rand -base64 32
# Losing it makes the stored syncs unreadable.
CONNECT_SECRET_KEY=

# --- Management auth ---------------------------------------------------------
# Neither set: OPEN mode, anyone who reaches the API manages every sync. The
# server only starts that way on a loopback LISTEN_ADDR or with
# ALLOW_OPEN_MODE=true. A variable set but blank is a startup error: comment
# it out instead.

# Standalone admin: `Authorization: Bearer <ADMIN_API_KEY>`. Global scope;
# may send `X-Connect-Tenant-Id` to act for a tenant.
ADMIN_API_KEY=dev-admin-key-change-me

# The Meilisearch Lab: `Authorization: Bearer <LAB_SERVICE_TOKEN>` plus a
# required `X-Connect-Tenant-Id`; every call is scoped to that tenant.
# LAB_SERVICE_TOKEN=

# Allow open mode on a non-loopback address (local development only).
# ALLOW_OPEN_MODE=false

# --- Host policy -------------------------------------------------------------
# Which hosts sources and Meilisearch destinations may point at:
#   public    names whose every address is public (default with LAB_SERVICE_TOKEN)
#   any       every host (default standalone)
#   allowlist only CONNECT_HOST_ALLOWLIST
# The state database (DATABASE_URL) is refused as a source in every mode.
CONNECT_HOST_POLICY=
# With `allowlist`: comma-separated host, host:port, IP addresses and CIDRs,
# e.g. `db.internal:5432,meilisearch,10.20.0.0/16`.
CONNECT_HOST_ALLOWLIST=

# --- Lab (all three or none) -------------------------------------------------
# With them: the usage of every tenant-owned sync (documents streamed,
# snapshot and resync, bytes, sync seconds: docs/LAB_INTEGRATION.md) goes to
# the Lab as signed `usage.recorded` events (product `connect`), and a team
# the Lab says cannot spend has its syncs held (`out_of_credits`) until it can.
LAB_URL=
LAB_INSTANCE_ID=
LAB_INSTANCE_SECRET=

# How often recorded usage with documents or bytes becomes outbox events
# (1-3600 s, default 60).
USAGE_FLUSH_INTERVAL_SECS=60
# How long a running sync's sync_seconds alone (an idle sync) wait before
# they become an event (1-86400 s, default 3600). A stopped sync's tail goes
# at once.
USAGE_IDLE_FLUSH_SECS=3600
# How long a sync's new phase must hold before the Lab is told
# (sync.state_changed; 0-3600 s, default 30).
SYNC_EVENTS_SETTLE_SECS=30
# How often the senders look for due events (1-300 s, default 2).
LAB_SEND_INTERVAL_SECS=2

# Credits (Lab mode): how often the teams are checked (1-3600 s, default 15),
# how long an answer is reused (default 30 s) and how long it is kept quietly
# when the Lab cannot answer (default 300 s; past it, the last answer is still
# used, with a warning: an unreachable Lab never holds every sync).
# CREDITS_CHECK_INTERVAL_SECS=15
# CREDITS_CACHE_FRESH_SECS=30
# CREDITS_CACHE_STALE_SECS=300

# --- Telemetry and analytics -------------------------------------------------

# Bearer token of GET /metrics (Prometheus). Unset: /metrics answers 404.
# Must differ from ADMIN_API_KEY and LAB_SERVICE_TOKEN. Generate:
# openssl rand -hex 32
# METRICS_TOKEN=

# Usage analytics in Tinybird (both or neither): every usage flush is also
# appended to the `connect_usage` data source (tinybird/README.md), and
# GET /usage reads the `connect_tenant_usage` pipe. TINYBIRD_URL is the
# workspace's regional API host; the token is `connect_engine` (APPEND on the
# data source, READ on the pipe).
# TINYBIRD_URL=https://api.eu-central-1.aws.tinybird.co
# TINYBIRD_TOKEN=

# Lag guard (off by default): a sync this far behind its origin (WAL bytes,
# or seconds) with no checkpoint for 5 minutes gets a `lag_warning` in its
# status. Nothing is dropped automatically: releasing a customer's slot or
# offsets loses its position, an operator decision.
# MAX_LAG_HOLD_BYTES=10737418240
# MAX_LAG_HOLD_SECS=21600

# --- Operations --------------------------------------------------------------

# Time limit of POST /sources/check and /sources/discover (1-600 s, default 30).
SOURCE_PROBE_TIMEOUT_SECS=30
# Time the syncs get to stop on SIGTERM/SIGINT (1-600 s, default 30). Also
# the longest wait for one sync to stop on pause, update or delete.
SHUTDOWN_GRACE_SECS=30

# --- Quotas and bounds -------------------------------------------------------

# Syncs one tenant may own (default 20). The global scope is not limited.
MAX_SYNCS_PER_TENANT=20
# `check` / `discover` running at once, in all and per tenant.
PROBE_CONCURRENCY=16
PROBE_CONCURRENCY_PER_TENANT=4
# Longest API request (5-3600 s, default 180).
REQUEST_TIMEOUT_SECS=180
# Dead letters kept per sync (default 10000); past it they are only counted.
DEAD_LETTERS_MAX_PER_SYNC=10000
# Unsent events of an outbox lane (Lab, Tinybird) beyond which usage stays
# pending in the state database instead of being enqueued (default 100000).
LAB_OUTBOX_MAX_PENDING=100000

# --- Logs --------------------------------------------------------------------

# `pretty` (default) or `json`.
LOG_FORMAT=pretty
# Simple level (`info`, `debug`…). RUST_LOG, when set, wins and takes the
# full filter syntax (e.g. `info,meili_connect_engine=debug`).
LOG_LEVEL=info
# RUST_LOG=

# --- compose.yaml only -------------------------------------------------------
MEILI_MASTER_KEY=dev-master-key-change-me
